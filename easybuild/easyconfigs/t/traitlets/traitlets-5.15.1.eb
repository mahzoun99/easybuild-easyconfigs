easyblock = 'PythonPackage'

name = 'traitlets'
version = '5.15.1'

homepage = 'https://github.com/ipython/traitlets'
description = """Traitlets is a lightweight pure Python library that provides a framework for defining, validating, and managing traits (typed attributes) on Python objects. It is a core dependency of the IPython/Jupyter ecosystem."""

toolchain = SYSTEM

source_urls = ['https://pypi.io/packages/source/t/%(namelower)s/']
sources = ['%(namelower)s-%(version)s.tar.gz']
checksums = ['7b1c07854fe25acb39e009bae49f11b79ff6cbb2f27999104e9110e7a6b53722']

moduleclass = 'lib'

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}
