easyblock = 'PythonPackage'

name = 'platformdirs'
version = '4.9.6'

homepage = 'https://github.com/tox-dev/platformdirs'
description = """A small Python package for determining appropriate platform-specific directories (e.g. user data dir)."""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}

source_urls = ['https://files.pythonhosted.org/packages/9f/4a/0883b8e3802965322523f0b200ecf33d31f10991d0401162f4b23c698b42/']
sources = ['%(name)s-%(version)s.tar.gz']
checksums = ['3bfa75b0ad0db84096ae777218481852c0ebc6c727b3168c1b9e0118e458cf0a']

dependencies = [
    ('Python', '3.14.2'),
]

moduleclass = 'base'

sanity_check_paths = {
    'files': [],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

software_license = 'LicenseUnknown'
software_license_urls = ['https://github.com/tox-dev/platformdirs/blob/main/LICENSE']
