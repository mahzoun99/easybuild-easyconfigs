    ('CUDA', '13.2.0', '', SYSTEM),
    ('cuDNN', '9.23.0.39', versionsuffix, SYSTEM),
    ('NCCL', '2.30.4', versionsuffix),
    ('Python', '3.12.3'),
    ('h5py', '3.16.0'),
    ('cURL', '8.17.0'),
